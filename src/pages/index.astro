---
import BaseLayout from '../layouts/BaseLayout.astro';
import { decodeEntities, findPage, staticHtml } from '../lib/wp';

const page = findPage('home');
const title = `Facilitr - ${decodeEntities(page.title.rendered)}`;
const description = decodeEntities(page.excerpt.rendered);
---

<BaseLayout
  title={title}
  description={description}
  canonical="/"
  bodyClass="home page-template-default page page-id-384279 elementor-default elementor-page elementor-page-384279"
>
  <h1 class="sr-only">Facilitr</h1>
  <Fragment set:html={staticHtml(page.content.rendered)} />
</BaseLayout>
