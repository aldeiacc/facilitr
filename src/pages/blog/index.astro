---
import FacilitrFooter from '../../components/FacilitrFooter.astro';
import FacilitrHeader from '../../components/FacilitrHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogCards } from '../../data/facilitr';

const description = 'Desenvolva as habilidades essenciais para liderar grupos de forma eficaz.';
---

<BaseLayout title="Blog - Facilitr" description={description} canonical="/blog/" bodyClass="facilitr-page facilitr-blog">
  <FacilitrHeader active="blog" />

  <section class="facilitr-hero facilitr-hero--compact">
    <div class="facilitr-blob facilitr-blob--one"></div>
    <div class="facilitr-blob facilitr-blob--two"></div>
    <div class="facilitr-hero__content">
      <p class="facilitr-kicker">Facilitr</p>
      <h1>Blog</h1>
      <p>Desenvolva as habilidades essenciais para liderar grupos de forma eficaz e torne-se o facilitador que o mundo precisa.</p>
    </div>
  </section>

  <section class="facilitr-section facilitr-post-grid-section">
    <div class="facilitr-grid facilitr-grid--three">
      {blogCards.map((post) => (
        <article class="facilitr-post-card facilitr-post-card--large">
          <a class="facilitr-post-card__media" href={post.href}>
            <img src={post.image} alt="" loading="lazy" />
            <span class="facilitr-post-card__arrow" aria-hidden="true">+</span>
          </a>
          <div>
            <p class="facilitr-kicker">Live Facilitr</p>
            <h2><a href={post.href}>{post.title}</a></h2>
            <p>{post.excerpt}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <FacilitrFooter />
</BaseLayout>
