---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pagina nao encontrada - Facilitr" description="Pagina nao encontrada.">
  <section style="min-height: 70vh; display: grid; place-items: center; padding: 48px 20px; text-align: center;">
    <div>
      <h1 style="font-size: clamp(2.5rem, 8vw, 5rem); margin: 0 0 16px; color: #bb0ee5;">404</h1>
      <p style="font-size: 1.125rem; margin: 0 0 24px; color: #54595f;">Pagina nao encontrada.</p>
      <a href="/" style="display: inline-block; padding: 12px 22px; border-radius: 999px; background: #91e80c; color: #111; font-weight: 800;">Voltar para Home</a>
    </div>
  </section>
</BaseLayout>
